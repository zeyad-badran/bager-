# Copy to .env.local for LOCAL development only. Never commit real values.
# Local Supabase values come from `supabase start` (printed in the terminal).
# Do NOT put production, staging, service-role or POS credentials in any file in this repo.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status` — local only>
